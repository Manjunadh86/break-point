# Optional. Free key from https://the-odds-api.com
# Used only to snapshot public bookmaker tennis lines (ATP/WTA coverage).
# Challenger is usually not on this API — add those matchups to the watchlist yourself.
ODDS_API_KEY=

# Comma-separated sport keys. tennis covers in-season ATP/WTA events.
ODDS_SPORT_KEYS=tennis_atp_us_open,tennis_atp_french_open,tennis_atp_wimbledon,tennis_atp_australian_open

# Bookmaker regions for The Odds API
ODDS_REGIONS=uk,eu,au
